{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "board",
  "description": "Lets the board page close its window, set its window title, open new board windows and drive its GitHub view",
  "windows": ["main", "board-*"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-set-title",
    "allow-open-window",
    "allow-open-main-window",
    "allow-github-view-show",
    "allow-github-view-hide",
    "allow-github-view-navigate"
  ]
}
