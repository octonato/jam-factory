server_label := "io.github.octonato.jam-factory.server"

# Default recipe — list available recipes when `just` is run with no args.
default:
    @just --list --unsorted

# clean up the release binary and the app bundle
clean:
    #!/usr/bin/env bash
    if [ -f target/release/jam-board ]; then
        rm target/release/jam-board
    fi

    if [ -d target/release/bundle ]; then
        rm -rf target/release/bundle
    fi

# format and lint the codebase (auto-fix)
format:
    cargo fmt --all
    cargo clippy --fix --all-targets --allow-dirty

# check formatting and lints (no mutation)
check:
    cargo fmt --all -- --check
    cargo clippy --all-targets --locked -- -D warnings

# run dashboard and Rust tests (cargo test compiles everything it needs)
test:
    node --test core/dashboard/dashboard.test.cjs
    cargo test --locked --all-targets

# Run the full CI quality-gate set: fmt, clippy, test.
build: check test

# Run the gates, then install Jam Board, both servers and jb.
install: build deploy

# Copy the app bundle to /Applications and both servers and jb to ~/.local/bin, then reload the server agent.
[private]
deploy:
    #!/usr/bin/env bash
    set -euo pipefail

    JAM_FACTORY_VERSION="$(./version build)"
    export JAM_FACTORY_VERSION
    echo "Installing Jam Board v${JAM_FACTORY_VERSION}"

    if ! cargo tauri --version >/dev/null 2>&1; then
        echo "Error: the Tauri CLI is missing. Run 'mise install' at the repository root." >&2
        exit 1
    fi

    cargo tauri build --bundles app

    if [ -d "/Applications/Jam Board.app" ]; then
        rm -rf "/Applications/Jam Board.app"
    fi

    cp -R "target/release/bundle/macos/Jam Board.app" /Applications/

    cargo build --release -p jam-factory-mcp
    mkdir -p "$HOME/.local/bin"
    rm -f "$HOME/.local/bin/jam-factory-mcp"
    cp target/release/jam-factory-mcp "$HOME/.local/bin/"

    cargo build --release -p jam-factory-server
    rm -f "$HOME/.local/bin/jam-factory-server"
    cp target/release/jam-factory-server "$HOME/.local/bin/"

    cargo build --release -p jb
    rm -f "$HOME/.local/bin/jb"
    cp target/release/jb "$HOME/.local/bin/"

    mkdir -p "$HOME/.jam-factory/logs" "$HOME/Library/LaunchAgents"

    plist="$HOME/Library/LaunchAgents/{{server_label}}.plist"
    log="$HOME/.jam-factory/logs/server.log"

    cat > "$plist" <<EOF
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>Label</key>
        <string>{{server_label}}</string>
        <key>ProgramArguments</key>
        <array>
            <string>$HOME/.local/bin/jam-factory-server</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <true/>
        <key>ProcessType</key>
        <string>Interactive</string>
        <key>StandardOutPath</key>
        <string>$log</string>
        <key>StandardErrorPath</key>
        <string>$log</string>
    </dict>
    </plist>
    EOF

    launchctl bootout "gui/$(id -u)/{{server_label}}" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"

# Stop the server agent and remove its plist and binary.
uninstall-server:
    #!/usr/bin/env bash
    set -euo pipefail

    launchctl bootout "gui/$(id -u)/{{server_label}}" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/{{server_label}}.plist"
    rm -f "$HOME/.local/bin/jam-factory-server"

# Build release (no gates) and run the produced binary, forwarding args.
run *ARGS:
    #!/usr/bin/env bash
    # Build the binary when it is missing.
    if [ ! -f target/release/jam-board ]; then
        cargo fmt --all
        cargo build --release -p jam-board
    else
        # Offer a rebuild when the binary is older than the latest commit that touched app/.
        latest_change="$(git log -1 --format=%ct -- .)"
        binary_mtime="$(stat -f %m target/release/jam-board 2>/dev/null || stat -c %Y target/release/jam-board 2>/dev/null)"
        if [[ "$binary_mtime" -lt "$latest_change" ]]; then
            echo "Warning: target/release/jam-board is older than the latest app change" >&2
            read -r -p "Do you want to rebuild first? (Y/n) " answer
            if [[ "$answer" != "n" && "$answer" != "N" ]]; then
                cargo fmt --all
                cargo build --release -p jam-board
            fi
        fi
    fi

    ./target/release/jam-board {{ARGS}}

# Bump the version (patch, minor, major or X.Y.Z), commit and tag it as vX.Y.Z, then install.
release BUMP="patch":
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -n "$(git status --porcelain)" ]]; then
      echo "Error: working tree is not clean" >&2
      exit 1
    fi

    if ! cargo tauri --version >/dev/null 2>&1; then
      echo "Error: the Tauri CLI is missing. Run 'mise install' at the repository root." >&2
      exit 1
    fi

    version="$(./version next "{{BUMP}}")"
    tag="v${version}"

    # Set the [workspace.package] version, the first `version = "..."` line in the file.
    sed -i.bak -E "1,/^version = \".*\"$/s/^version = \".*\"$/version = \"${version}\"/" Cargo.toml
    rm -f Cargo.toml.bak

    # Refresh Cargo.lock for the workspace members.
    cargo update --workspace >/dev/null

    if ! just build; then
      git restore Cargo.toml Cargo.lock
      exit 1
    fi

    git add Cargo.toml Cargo.lock
    git commit -m "rel: ${tag}"
    git tag -a "${tag}" -m "rel: ${tag}"

    if ! just deploy; then
      echo "Error: ${tag} is committed and tagged, but not installed. Fix the cause, run 'just install', then push the branch and the tag ${tag}." >&2
      exit 1
    fi

    echo "Released ${tag} (commit + tag created)."
    read -r -p "Do you want to push it? (Y/n) " answer
    if [[ "$answer" != "n" && "$answer" != "N" ]]; then
        git push && git push upstream "${tag}"
    fi
